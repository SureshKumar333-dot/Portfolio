# Leave empty for local dev (Vite proxies /api to localhost:5000)
# Production (optional): Railway backend URL, e.g. https://your-app.up.railway.app
VITE_API_URL=

# GitHub Pages contact form (get free key at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=

# GitHub Pages only: /Portfolio/ (match your repo name)
VITE_BASE_PATH=/
